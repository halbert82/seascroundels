{
  "name": "sea-scoundrels",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "capturas": "node scripts/capturar-cartas.mjs",
    "comparar": "node scripts/comparar-cartas.mjs",
    "capturas:galeria": "npm run build && node scripts/capturar-galeria.mjs",
    "equilibrio": "INFORME=1 vitest run src/engine/equilibrio.informe.test.ts",
    "capturas:mesa": "npm run build && node scripts/capturar-mesa.mjs",
    "capturas:ayudas": "npm run build && node scripts/capturar-ayudas.mjs",
    "capturas:zoom": "npm run build && node scripts/capturar-zoom.mjs",
    "jugar:mesa": "npm run build && node scripts/jugar-desde-mesa.mjs",
    "comprobar:barra": "npm run build && node scripts/comprobar-barra.mjs",
    "reglamento": "npm run build && node scripts/reglamento.mjs",
    "reglamento:pdf": "node scripts/reglamento.mjs --solo-pdf",
    "reglamento:paginas": "node scripts/paginas-libro.mjs",
    "comprobar:reglamento": "npm run build && node scripts/comprobar-reglamento.mjs"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/alegreya-sans-sc": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "markdown-it": "^14.3.3",
    "motion": "^14.3.0",
    "pagedjs": "^0.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
